{
  "manifest_version": 3,
  "name": "LiquidDo – To-Do List",
  "version": "1.0.0",
  "description": "A beautiful Liquid Glass to-do list. Add, complete, and manage tasks right from your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
